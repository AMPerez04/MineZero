{
  "schemaVersion": 1,
  "id": "minezero",
  "version": "${version}",

  "name": "MineZero",
  "description": "A mod inspired by Re:Zero. When you die, you return to a checkpoint and restore your previous state.",
  "authors": [
    "LethallyGood"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/mine-zero-return-by-death",
    "sources": "https://www.curseforge.com/minecraft/mc-mods/mine-zero-return-by-death"
  },
  "license": "All Rights Reserved",
  "icon": "assets/minezero/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "boomcow.minezero.MineZeroMain"
    ],
    "client": [
      "boomcow.minezero.MineZeroClient"
    ],
    "modmenu": [
      "boomcow.minezero.config.ModMenuIntegration"
    ]
  },

  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
